# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Flash-class recommended for fast streaming and free tier)
GEMINI_MODEL=gemini-flash-latest

# Local Embedding Model (Sentence Transformers)
# Options:
# - BAAI/bge-small-en-v1.5 (Default, high accuracy for English, ~130MB)
# - sentence-transformers/all-MiniLM-L6-v2 (Ultra fast, ~90MB)
# - intfloat/multilingual-e5-small (Recommended for multilingual / Hindi, ~470MB)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Transcript Chunking Configuration
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Retrieval Configuration
TOP_K=5
MMR_LAMBDA=0.7

# ChromaDB Storage Directory
CHROMA_DIR=./chroma_db
